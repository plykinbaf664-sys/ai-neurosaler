# Storage adapter. Defaults to local when omitted.
STORAGE_DRIVER=local
LOCAL_DATA_MODE=file
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage/egress limits.
MAX_MESSAGE_HISTORY=12
MAX_MATERIAL_TEXT_CHARS=12000
MAX_MATERIALS_PER_LEAD=2

# Optional ecosystem library. Keep false to preserve the legacy /start flow.
LIBRARY_ENABLED=false
LIBRARY_LINK_SECRET=
LIBRARY_FOLLOWUPS_ENABLED=false
LIBRARY_FOLLOWUP_DELAY_HOURS=24
LIBRARY_FOLLOWUP_INACTIVITY_HOURS=12

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=

# AI: qwen or anthropic. Existing deployments without AI_PROVIDER keep Anthropic.
AI_PROVIDER=qwen
QWEN_API_KEY=
# Paste the OpenAI-compatible base URL from the SAME region/workspace as the API key.
# Singapore example: https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus
# Used only if AI_PROVIDER=anthropic. Not required for Qwen.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

CALENDAR_LINK=
NEIRO_GIFT_URL=
CRON_SECRET=
NEIRO_ENTRY_FLOW_MODE=quiz
GIFT_FOLLOWUPS_ENABLED=true
# Permanent HTTPS application origin for Mini App and tracked links; takes priority over webhook URL.
PUBLIC_BASE_URL=
# Optional alternative to PUBLIC_BASE_URL.
NEXT_PUBLIC_APP_URL=

# Apply migration 016 before enabling the AI map / generated visuals.
# AI map includes direct access to both library categories.
AI_MAP_ENABLED=true
WELCOME_VIDEO_ENABLED=true
WELCOME_VIDEO_NOTE_FILE_ID=
# Optional media admin override. Defaults to existing TELEGRAM_ADMIN_USER_ID.
ADMIN_TELEGRAM_ID=
QUIZ_FOLLOWUPS_ENABLED=true
# Vercel Hobby invokes this endpoint daily. For 1h/3h follow-ups, an external scheduler
# must GET /api/cron/library-followups every 5 minutes with Authorization: Bearer CRON_SECRET.
IMAGE_GENERATION_ENABLED=true
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1.5
# Optional dedicated image key; defaults to existing OPENAI_API_KEY when empty.
# Only uncached screens need a credential. Ready screen assets are reused without it.
# Changing provider/model does not regenerate ready screens. Qwen/Anthropic stays unchanged.
IMAGE_API_KEY=
